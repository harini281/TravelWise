# ====================================================================
# TravelWise - Global Environment Variables Template
# ====================================================================
# Copy this file to .env in local development environments.
# Never commit actual production secrets to version control.

# --- ASP.NET Core Backend Configuration ---
DATABASE_URL=Host=localhost;Port=5432;Database=travelwise;Username=postgres;Password=postgres
JWT_SECRET=travelwise_super_secret_jwt_key_for_university_evaluation_2026!
AISERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- FastAPI AI Service Configuration ---
API_BASE_URL=http://localhost:5179
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- React Frontend Configuration ---
